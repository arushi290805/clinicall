PORT=5000
CORS_ORIGIN=http://localhost:5173

# Supabase Postgres — use the pooler for the app (port 6543)
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true

# Direct connection for Prisma db push / migrations (port 5432)
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Or: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# OpenAI — required for the voice booking agent
OPENAI_API_KEY=sk-...

# Optional Supabase JS client (not required for Prisma routes)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
